ENVIRONMENT=development

# Neon pooled endpoint for normal FastAPI traffic.
DATABASE_URL=
# Neon direct endpoint for Alembic migrations.
DIRECT_DATABASE_URL=

JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

CORS_ORIGINS=http://localhost:3000,http://localhost:5173
APP_TIMEZONE=Asia/Kolkata
BOOKING_HOLD_MINUTES=10

# Phase 2: use only in an untracked .env.phase2 against separate Neon phase2-dev.
# Generate once using cryptography.fernet.Fernet.generate_key(); retain for old versions.
CREDENTIAL_ENCRYPTION_KEY=
PUBLIC_API_URL=http://localhost:8000
