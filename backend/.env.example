ENVIRONMENT=development

# Neon pooled endpoint for normal FastAPI traffic.
DATABASE_URL=
# Neon direct endpoint for Alembic migrations.
DIRECT_DATABASE_URL=

JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

CORS_ORIGINS=http://localhost:3000,http://localhost:5173
APP_TIMEZONE=Asia/Kolkata
BOOKING_HOLD_MINUTES=10

# Phase 2: use only in an untracked .env.phase2 against separate Neon phase2-dev.
# Generate once using cryptography.fernet.Fernet.generate_key(); retain for old versions.
CREDENTIAL_ENCRYPTION_KEY=
PUBLIC_API_URL=http://localhost:8000
RESEND_API_KEY=
EMAIL_FROM="Typein <hello@typein.co>"

# WhatsApp Cloud API: configure on the backend service only after confirming
# the real WABA, phone-number ID, approved templates, and sending controls.
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_TOKEN=
WHATSAPP_API_VERSION=v26.0

# Merchant subscriptions. Use test values outside production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_ID=
RAZORPAY_WEBHOOK_SECRET=
BILLING_TRIAL_DAYS=30
BILLING_PLAN_AMOUNT_PAISE=149900
BILLING_TOTAL_COUNT=120
BILLING_GRACE_DAYS=3
